{
  "name": "get-my-colors",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:one-run": "vitest --no-watch",
    "prepare": "husky",
    "lint": "eslint .",
    "commit": "commit",
    "prettier": "prettier --config .prettierrc './**/*.{js,ts}' --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@commitlint/prompt-cli": "^19.7.1",
    "@commitlint/types": "^19.5.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "vitest": "^3.0.6"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.21.0",
    "globals": "^16.0.0",
    "tsup": "^8.3.6"
  },
  "lint-staged": {
    "**/*.{ts}": [
      "npm run lint",
      "npm run prettier"
    ]
  }
}